{
  "expo": {
    "name": "ShipShape 90",
    "slug": "shipshape90",
    "scheme": "shipshape90",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shipshape90.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shipshape90.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "ShipShape 90 accesses a photo only when you choose a profile picture or challenge evidence.",
          "cameraPermission": "ShipShape 90 uses the camera only when you choose to capture a profile picture or challenge evidence.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24d823fc-c697-46b1-97c6-b833810ba19a"
      }
    },
    "owner": "faheybaby"
  }
}

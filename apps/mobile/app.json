{
  "expo": {
    "name": "ShipShape 90",
    "slug": "shipshape90",
    "scheme": "shipshape90",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "icon": {
        "light": "./assets/ios-icon-light.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "com.shipshape90.app",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shipshape90.app",
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#14181D"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-apple-authentication",
      "expo-notifications",
      "@sentry/react-native/expo",
      [
        "expo-image-picker",
        {
          "photosPermission": "ShipShape 90 accesses photos only when you choose a profile picture or a private progress photo.",
          "cameraPermission": "ShipShape 90 uses the camera only when you choose to capture a profile picture or a private progress photo.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EFE7",
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#14181D",
            "image": "./assets/splash-icon-dark.png"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/24d823fc-c697-46b1-97c6-b833810ba19a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "24d823fc-c697-46b1-97c6-b833810ba19a"
      }
    },
    "owner": "faheybaby"
  }
}
